[Unit]
Description=Gemma 4 31B vLLM replica on GPU %i
Documentation=file://@REPO_ROOT@/docs/gemma4_vllm_operations.md
After=network-online.target
Wants=network-online.target
PartOf=gemma4-vllm.target
StartLimitIntervalSec=600
StartLimitBurst=5

[Service]
Type=simple
Environment=PYTHONUNBUFFERED=1
Environment=GEMMA4_VLLM_ROOT=@VLLM_ROOT@
ExecStart=/usr/bin/python3 @REPO_ROOT@/scripts/manage_gemma4_vllm.py serve-replica --slot %i
ExecStartPost=/usr/bin/python3 @REPO_ROOT@/scripts/manage_gemma4_vllm.py wait-ready --slot %i --timeout 900
Restart=on-failure
RestartSec=15
KillMode=control-group
KillSignal=SIGTERM
SendSIGKILL=yes
TimeoutStartSec=960
TimeoutStopSec=180
SyslogIdentifier=gemma4-vllm-%i

[Install]
WantedBy=gemma4-vllm.target
