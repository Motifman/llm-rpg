{
  "profile": "station_drill_jev",
  "description": "行動名・対象名の選び直しを Jev の型付き判断で行う観察用。station_drill_thinking との差は OPENROUTER_PROVIDER (GMICloud。Cloudflare の 1/4 の単価で tool_choice=required を満たし、Baidu の共有プール枯渇が無い) と TYPED_JUDGMENT_PROVIDER=jev の 2 つだけ。",
  "scenario": "data/scenarios/station_drill.json",
  "max_world_ticks": 50,
  "snapshot_save": false,
  "runtime_config": {
    "LLM_CLIENT": "litellm",
    "LLM_MODEL": "openrouter/deepseek/deepseek-v4-flash",
    "OPENAI_API_BASE": "https://openrouter.ai/api/v1",
    "OPENROUTER_PROVIDER": "GMICloud",
    "OPENROUTER_REQUIRE_PARAMS": false,
    "LLM_REASONING_EFFORT": "minimal",
    "LLM_TURN_PARALLEL_WORKERS": 8,
    "LLM_MEETING_SERIAL_TURNS": false,
    "LLM_IDLE_TIMEOUT_TICKS": 6,
    "SHORT_TERM_MEMORY_KIND": "rolling_summary",
    "LLM_EPISODIC_ENABLED": false,
    "LLM_EPISODIC_SUBJECTIVE_ENABLED": false,
    "EPISODIC_PROMOTION_FORCE_FULL_SCAN": false,
    "EPISODIC_PROMOTION_EXPANSION_HOPS": 4,
    "LLM_EPISODIC_RECALL_HABITUATION_ENABLED": false,
    "LLM_EPISODIC_RECALL_HABITUATION_DECAY_TICKS": 5,
    "LLM_EPISODIC_RECALL_SLOT_ENABLED": false,
    "LLM_EPISODIC_RECALL_SLOT_CAPACITY": 4,
    "LLM_EPISODIC_RECALL_SLOT_INSERT_PER_TICK": 1,
    "LLM_EPISODIC_RECALL_SLOT_MAX_RESIDENCE": 8,
    "LLM_EPISODIC_RECALL_SLOT_COOLDOWN": 5,
    "LLM_EPISODIC_RECALL_SLOT_INSERT_SCORE_THRESHOLD": 2,
    "SEMANTIC_LLM_GIST_ENABLED": false,
    "SEMANTIC_PASSIVE_TOP_K": 3,
    "BELIEF_EVIDENCE_ENABLED": false,
    "BELIEF_CONSOLIDATION_ENABLED": false,
    "BELIEF_ATTRIBUTION_ENABLED": false,
    "REASON_FIRST_TWO_STEP_ENABLED": true,
    "PROMPT_DATASET_CAPTURE_ENABLED": true,
    "PROMPT_DATASET_CAPTURE_FAILURE_POLICY": "warn",
    "SCENARIO_RANDOM_SEED": 42,
    "TYPED_JUDGMENT_PROVIDER": "jev"
  }
}
