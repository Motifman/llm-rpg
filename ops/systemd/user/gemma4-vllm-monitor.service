[Unit]
Description=Check active Gemma 4 vLLM replicas and restart repeated failures
After=gemma4-vllm.target

[Service]
Type=oneshot
Environment=PYTHONUNBUFFERED=1
Environment=GEMMA4_VLLM_ROOT=@VLLM_ROOT@
ExecStart=/usr/bin/python3 @REPO_ROOT@/scripts/manage_gemma4_vllm.py monitor --restart-after 3
SyslogIdentifier=gemma4-vllm-monitor
